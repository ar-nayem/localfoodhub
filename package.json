{
  "name": "localfoodhub",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev -p 4410",
    "build": "NODE_OPTIONS=--max-old-space-size=1400 next build",
    "start": "next start -p ${PORT:-4410}",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed"
  },
  "dependencies": {
