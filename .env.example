DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-only-change-me-in-production-please"
NEXT_PUBLIC_BASE_URL="http://localhost:4410"
# The Business app (shop owners and staff) — a second hostname served by this same app.
# Leave empty to serve everything from NEXT_PUBLIC_BASE_URL alone. *.localhost resolves to
# this machine in Chrome, so the value below works locally with no /etc/hosts entry.
# Both NEXT_PUBLIC_ URLs are baked in at build time: rebuild after changing either.
NEXT_PUBLIC_BUSINESS_URL="http://business.localhost:4410"
# Maps JavaScript API + Places API (New) must be enabled on this key's Google Cloud
# project; restrict it by HTTP referrer (your domain) once live. Client-visible by
# design (NEXT_PUBLIC_) — Google Maps keys are secured by referrer/API restrictions,
# never by keeping them secret. Location features fall back to the existing
# Leaflet/manual-entry flow when this is unset.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Google Sign-In — create an OAuth 2.0 Client ID (type: Web application) in Google Cloud,
# and register this exact redirect URI on it:
#   https://your-domain/api/auth/google/callback
# Free, unlimited. Without these, the Google button reports itself unavailable rather than
# breaking sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email OTP delivery over SMTP. Works with any provider — Brevo (300/day free),
# Gmail app passwords (500/day), Resend, Mailgun. Unset, codes go to the server log only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="শখের খাবার <no-reply@your-domain>"

# Android app links (Play Store). One pair per app — see app/api/well-known/assetlinks.
ANDROID_PACKAGE_NAME=""
ANDROID_SHA256_CERT_FINGERPRINTS=""
ANDROID_BUSINESS_PACKAGE_NAME=""
ANDROID_BUSINESS_SHA256_CERT_FINGERPRINTS=""
