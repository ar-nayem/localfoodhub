DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-only-change-me-in-production-please"
NEXT_PUBLIC_BASE_URL="http://localhost:4410"
# Maps JavaScript API + Places API (New) must be enabled on this key's Google Cloud
# project; restrict it by HTTP referrer (your domain) once live. Client-visible by
# design (NEXT_PUBLIC_) — Google Maps keys are secured by referrer/API restrictions,
# never by keeping them secret. Location features fall back to the existing
# Leaflet/manual-entry flow when this is unset.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
